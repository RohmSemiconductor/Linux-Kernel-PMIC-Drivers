/dts-v1/;

#include "am33xx.dtsi"
#include "am335x-bone-common.dtsi"
#include "am335x-boneblack-common.dtsi"

/ {
	model = "TI AM335x BeagleBone Black";
	compatible = "ti,am335x-bone-black", "ti,am335x-bone", "ti,am33xx";
};

/* MVa Added */
&i2c2 {
	companionpmic: companion@47 {
		compatible = "rohm,bd71892";
		reg = <0x47>;
		/* GPIO 1_29 - (connector 8, pin 26) for irq */
/*		interrupt-parent = <&gpio1>; */
/*		interrupts = <29 GPIO_ACTIVE_LOW>; */
/*		interrupts = <29 8>; */

		regulators {
			buck1 {
				regulator-name = "buck1";
/*
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1350000>;
*/
/*				regulator-boot-on; */
/*				regulator-always-on; */
				regulator-ramp-delay = <1250>;
			};
			buck2 {
				regulator-name = "buck2";
/*
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1350000>;
				regulator-always-on;
				regulator-ramp-delay = <1250>;
*/
			};
			buck3 {
				regulator-name = "buck3";
/*
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1350000>;
		//		regulator-boot-on;
				rohm,no-regulator-enable-control;
*/
			};
			buck4 {
				regulator-name = "buck4";
/*
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1850000>;
				regulator-boot-on;
*/
			};
			buck5 {
				regulator-name = "buck5";
			};
			ldo1 {
				regulator-name = "ldo1";
			};
		};
	};
	bdpmic: pmic@4b { /* the "test" defined as child of the i2c1 bus */
		compatible = "rohm,bd71891";
		reg = <0x4b>;
		/* GPIO 1_29 - (connector 8, pin 26) for irq */
/*		interrupt-parent = <&gpio1>; */
/*		interrupts = <29 GPIO_ACTIVE_LOW>; */
/*		interrupts = <29 8>; */
/*		rohm,short-press-ms = <30>;
		rohm,mid-press-ms = <1000>;
		rohm,long-press-ms = <5000>;
*/

		regulators {
			buck1: BUCK1 {
				regulator-name = "buck1";
/*
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1300000>;
*/
/*				regulator-boot-on; */
/*				regulator-always-on; */
/*				regulator-ramp-delay = <1250>; */
			};
			buck2: BUCK2 {
				regulator-name = "buck2";
/*				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1300000>;
				regulator-always-on;
				regulator-ramp-delay = <1250>;
*/
			};
			buck3: BUCK3 {
				regulator-name = "buck3";
/*
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1300000>;
		//		regulator-boot-on;
				rohm,no-regulator-enable-control;
*/
			};
			buck4: BUCK4 {
				regulator-name = "buck4";
/*				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1300000>;
				regulator-boot-on;
*/
			};
			boost: BOOST {
				regulator-name = "boost";
/*
				regulator-min-microvolt = <300000>;
				regulator-max-microvolt = <1300000>;
				regulator-boot-on;
*/
			};

			ldo1: LDO1 {
				regulator-name = "ldo1";
/*
				regulator-min-microvolt = <1500000>;
				regulator-max-microvolt = <3500000>;
				regulator-boot-on;
*/
			};

			ldo2: LDO2 {
				regulator-name = "ldo2";
/*
				regulator-min-microvolt = <1500000>;
				regulator-max-microvolt = <3500000>;
				regulator-boot-on;
*/
			};
		};
	};
};

&cpu0_opp_table {
	/*
	 * All PG 2.0 silicon may not support 1GHz but some of the early
	 * BeagleBone Blacks have PG 2.0 silicon which is guaranteed
	 * to support 1GHz OPP so enable it for PG 2.0 on this board.
	 */
	oppnitro-1000000000 {
		opp-supported-hw = <0x06 0x0100>;
	};
};

